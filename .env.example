# PostgreSQL (Prisma). Local example:
#   createdb rustine
#   DATABASE_URL="postgresql://USER@127.0.0.1:5432/rustine"
# Vercel / Neon / Vercel Postgres: paste the connection string (include sslmode=require).
# Prefer the pooled URL for serverless; Prisma migrate deploy also works with the direct URL.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/rustine?sslmode=require"

# Signed session cookies. Generate with: openssl rand -base64 48
# Required in production (min. 16 characters). Never commit the real value.
AUTH_SECRET="change-me-in-production-use-a-long-random-string"

# Aurora / Vantage. Leave empty to run with local mocks (DRY_RUN).
AURORA_API_KEY=
AURORA_BASE_URL="https://vantage-api.agency-aurora.com"

# Meta Graph / Marketing API. Leave both tokens empty to run the Meta module in simulation.
# Either token switches the client off mocks (live Graph path, even if the network call fails).
META_ACCESS_TOKEN=
META_PAGE_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_PAGE_ID=
META_GRAPH_VERSION="v21.0"
# Optional. Used by GET /api/webhooks/meta (hub.verify_token). Leave empty to accept any token.
META_WEBHOOK_VERIFY_TOKEN=
